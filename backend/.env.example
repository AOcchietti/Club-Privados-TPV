# Copia este archivo como "backend/.env" para trabajar en local.

# MongoDB local (MongoDB Community Server) o la cadena de conexión de MongoDB Atlas
MONGO_URL=mongodb://localhost:27017
DB_NAME=weedlemon_local

# Cualquier frase larga y secreta (firma las sesiones)
JWT_SECRET=cambia-esto-por-una-frase-larga-y-secreta-de-al-menos-32-caracteres

# Dirección del frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# En local (http) las cookies no pueden ser "Secure". En producción (https) quita esta línea.
COOKIE_SECURE=false

# Administrador que se crea al arrancar por primera vez
ADMIN_EMAIL=admin@weedlemon.es
ADMIN_PASSWORD=admin123

# Sin clave de Emergent, las fotos y el PDF legal se guardan en backend/uploads/
# EMERGENT_LLM_KEY=
